# Copy to your private environment settings (Vercel → Settings → Environment
# Variables) and set real values there. Never commit .env or real credentials.
# Full step-by-step guide: VERCEL_SETUP.md

# Required — Neon Postgres connection string. The Vercel ↔ Neon integration
# (Storage tab) creates it for you. POSTGRES_URL works too.
DATABASE_URL=

# Required for "Admin হিসেবে delete" in the community (pick a long password).
ADMIN_PASSWORD=

# Required for the daily reminder notification: Vercel Cron sends it to /api/push-cron.
# Any long random text, e.g. from: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CRON_SECRET=

# Required for browser notifications: a P-256 private key as one-line JSON (JWK).
# Make one with the command in VERCEL_SETUP.md. The public key is derived from it.
VAPID_PRIVATE_JWK=
