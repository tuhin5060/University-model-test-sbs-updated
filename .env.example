# Copy to your private environment configuration and set real values there.
# Never commit .env, .env.local, or real credentials to Git.
# Required by the MongoDB-backed Vercel API routes:
MONGODB_URI=
# (The Vercel MongoDB Atlas integration may create MONGODB_URL or <PREFIX>_URL instead — that works too.)
MONGODB_DB=admission_companion

# Optional only if you separately re-enable a Vercel Blob integration:
# BLOB_READ_WRITE_TOKEN=
