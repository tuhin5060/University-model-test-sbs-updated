{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/profile",
      "destination": "/University-Admissions-Games-Quizzes-v2.0.2/University-Admissions-Games-Quizzes/api/profile"
    },
    {
      "source": "/api/scores",
      "destination": "/University-Admissions-Games-Quizzes-v2.0.2/University-Admissions-Games-Quizzes/api/scores"
    },
    {
      "source": "/(.*)",
      "destination": "/University-Admissions-Games-Quizzes-v2.0.2/University-Admissions-Games-Quizzes/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
