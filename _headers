# Cloudflare Pages headers (Vercel uses vercel.json; keep them the same).
# The Content-Security-Policy line is written by `npm run sync` (hashes of the
# inline scripts in index.html). The old Tense Express page keeps its own scripts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-2WR80yMJ1qZ5O5wfv7s2ycOh18G1Wt+sxIVByagR/0s=' 'sha256-3qzVakPu80GyjVsHG4idBlqac6JpwvoystjdvAZsk9g=' 'sha256-ElShUWg/R0NC6WIMZp3N2FKE5siI90ZKCnHMHJYcUhk=' 'sha256-dkNnXvoVdfwpPyUzu+tiZgEAw9HtFCF0Z45YFqtOmsk='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://commons.wikimedia.org https://upload.wikimedia.org; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
/tense-express/*
  ! Content-Security-Policy
# Images are reused from the browser cache; code, styles and data are always checked
# for a newer version so a deploy never mixes old and new files.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
