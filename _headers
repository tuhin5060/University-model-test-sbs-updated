# Cloudflare Pages headers (Vercel uses vercel.json). Code and data are reused
# from the browser cache at once and refreshed in the background, so a repeat
# visit opens without waiting for the network; index.html is always fresh.
/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
